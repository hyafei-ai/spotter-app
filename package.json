{
  "name": "spotter",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages apps",
    "test": "turbo run test",
    "client": "pnpm --filter @spotter/client start",
    "coach": "pnpm --filter @spotter/coach start",
    "format": "prettier --write .",
    "icons": "python3 scripts/make-tenant-icons.py < packages/core/src/demo-tenants.json",
    "web": "pnpm --filter @spotter/web dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "typescript-eslint": "^8.72.0"
  }
}
