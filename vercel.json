{
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/coach-app/(.*)", "destination": "/coach-app/index.html" },
    { "source": "/shared/(.*)", "destination": "/shared/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
